<?xml version="1.0" ?>
<sdf version="1.8">
    <model name="endoscope_light_model">
        <pose>0 0 0 0 0 0</pose>
        <static>true</static>
        <link name="light_link">
            <light name="endoscope_light" type="spot">
                
                <pose>0 0 0.005 0 0 0</pose>
                
                <diffuse>1.0 1.0 1.0 1.0</diffuse>
                <specular>0.5 0.5 0.5 1.0</specular>
                <attenuation>
                    <range>0.5</range>
                    <constant>0.1</constant>
                    <linear>0.01</linear>
                    <quadratic>0.001</quadratic>
                </attenuation>
                <spot>
                    <inner_angle>0.2</inner_angle>
                    <outer_angle>0.4</outer_angle>
                    <falloff>1.0</falloff>
                </spot>
            </light>
        </link>
    </model>
</sdf>