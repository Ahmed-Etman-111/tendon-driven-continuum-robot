<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tendon_continuum">

    <material name="dark_grey"><color rgba="0.2 0.2 0.2 1.0"/></material>
    <material name="nitinol_blue"><color rgba="0.1 0.2 0.5 1.0"/></material>
    <material name="black_rod"><color rgba="0.05 0.05 0.05 1.0"/></material>

    <link name="world"/>

    <joint name="world_to_base" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="base_link">
        <visual>
            <geometry><box size="0.05 0.05 0.01"/></geometry>
            <material name="dark_grey"/>
        </visual>
        <collision>
            <geometry><box size="0.05 0.05 0.01"/></geometry>
        </collision>
        <inertial>
            <mass value="0.5"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
    </link>

<xacro:macro name="continuum_segment" params="index parent">
        
        <joint name="pitch_joint_${index}" type="revolute">
            <parent link="${parent}"/>
            <child link="dummy_pitch_${index}"/>
            <origin xyz="0 0 0.023" rpy="0 0 0"/> 
            <axis xyz="0 1 0"/> 
            <limit lower="-1.57" upper="1.57" effort="100.0" velocity="10.0"/>
            <dynamics damping="0.005" friction="0.0"/>
        </joint>
        
        <link name="dummy_pitch_${index}">
            <inertial><mass value="0.001"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
        </link>

        <joint name="yaw_joint_${index}" type="revolute">
            <parent link="dummy_pitch_${index}"/>
            <child link="dummy_yaw_${index}"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <axis xyz="1 0 0"/> 
            <limit lower="-1.57" upper="1.57" effort="100.0" velocity="10.0"/>
            <dynamics damping="0.005" friction="0.0"/>
        </joint>
        
        <link name="dummy_yaw_${index}">
            <inertial><mass value="0.001"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
        </link>

        <joint name="contraction_joint_${index}" type="prismatic">
            <parent link="dummy_yaw_${index}"/>
            <child link="disk_${index}"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <axis xyz="0 0 1"/> 
            <limit lower="-0.01" upper="0.002" effort="100.0" velocity="10.0"/>
            <dynamics damping="0.01" friction="0.0"/>
        </joint>

        <link name="disk_${index}">
            <visual>
                <geometry>
                    <cylinder radius="0.01" length="0.01"/>
                </geometry>
                <material name="nitinol_blue"/>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="0.01" length="0.01"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.01"/>
                <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
            </inertial>
        </link>
    </xacro:macro>

    <xacro:continuum_segment index="1" parent="base_link" />
    <xacro:continuum_segment index="2" parent="disk_1" />
    <xacro:continuum_segment index="3" parent="disk_2" />
    <xacro:continuum_segment index="4" parent="disk_3" />
    <xacro:continuum_segment index="5" parent="disk_4" />
    <xacro:continuum_segment index="6" parent="disk_5" />
    <xacro:continuum_segment index="7" parent="disk_6" />
    <xacro:continuum_segment index="8" parent="disk_7" />
    <xacro:continuum_segment index="9" parent="disk_8" />
    <xacro:continuum_segment index="10" parent="disk_9" />


   <xacro:macro name="continuum_control" params="index">
        <joint name="pitch_joint_${index}">
            <command_interface name="position"/>
            <state_interface name="position"/>
        </joint>
        <joint name="yaw_joint_${index}">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <param name="p">100.0</param>
            <param name="d">5.0</param>
        </joint>
        <joint name="contraction_joint_${index}">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <param name="p">1000.0</param>
            <param name="d">10.0</param>
        </joint>
    </xacro:macro>

    <joint name="camera_joint" type="fixed">
        <parent link="disk_10"/>
        <child link="camera_link"/>
        <origin xyz="0 0 0.003" rpy="0 -1.5708 0"/>
    </joint>

    <link name="camera_link">
        <visual>
            <geometry><box size="0.005 0.005 0.005"/></geometry>
            <material name="dark_grey"/>
        </visual>
        <inertial>
            <mass value="0.001"/>
            <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
        </inertial>
        
    </link>

    <gazebo reference="camera_link">

        <light name="endoscope_light" type="spot">
            <pose>0 0 0 0 -1.5708 0</pose>
            <diffuse>1.0 1.0 1.0 1.0</diffuse>
            <specular>0.5 0.5 0.5 1.0</specular>
            <attenuation>
                <range>1.5</range>
                <constant>0.1</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <spot>
                <inner_angle>0.2</inner_angle>
                <outer_angle>1.6</outer_angle>
                <falloff>1.0</falloff>
            </spot>
        </light>


        <sensor type="camera" name="tip_camera">
            <always_on>true</always_on>
            <update_rate>30.0</update_rate>
            <topic>/camera/image_raw</topic>
            <camera>
                <horizontal_fov>1.047</horizontal_fov>
                <image>
                    <width>400</width>
                    <height>300</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.001</near>
                    <far>5.0</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>


    <ros2_control name="GazeboSimSystem" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <xacro:continuum_control index="1" />
        <xacro:continuum_control index="2" />
        <xacro:continuum_control index="3" />
        <xacro:continuum_control index="4" />
        <xacro:continuum_control index="5" />
        <xacro:continuum_control index="6" />
        <xacro:continuum_control index="7" />
        <xacro:continuum_control index="8" />
        <xacro:continuum_control index="9" />
        <xacro:continuum_control index="10" />



    </ros2_control>

    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find tendon_continuum)/config/controllers.yaml</parameters>
        </plugin>

        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>
    </gazebo>

</robot>